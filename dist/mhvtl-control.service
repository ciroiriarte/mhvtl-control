[Unit]
Description=mhVTL management daemon (REST API and web dashboard)
Documentation=https://github.com/ciroiriarte/mhvtl-control
# Ordered after mhVTL when both start, but not tied to it: mhvtl-control opens the
# message queue and finds the changers on demand, so it may start first and
# survives mhVTL restarts.
After=network.target mhvtl.target
# A configuration error (such as a non-loopback --listen without a token)
# exits at once; stop retrying after 5 failed starts in a minute rather than
# restart forever. A transient failure still gets its retries.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/mhvtl-control/mhvtl-control.env
ExecStart=/usr/bin/mhvtl-control $MHVTL_CONTROL_OPTS
Restart=on-failure
RestartSec=5

# mhvtl-control runs as root: the mhVTL message queue is root's (mode 0660), and it
# opens /dev/sg* and the disks it formats, all root-owned. Every capability
# is dropped but CAP_DAC_OVERRIDE, which lets mktape and edit_tape write media
# homes owned by another user: mhVTL ran as user "vtl" until 2018, and older
# homes are still vtl-owned. SG_IO needs no CAP_SYS_RAWIO here, as the sg
# nodes are opened read-write.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
# full, not strict: media homes can be anywhere device.conf puts them, except
# under /home, /root and /run/user, which ProtectHome hides.
ProtectSystem=full
ProtectHome=yes
# Keep the daemon away from the service manager and the config-apply helper,
# so a compromised daemon cannot start units or write to the helper. The paths
# carry no '-': a '-' path missing at start is skipped silently, so the package
# creates both helper directories (tmpfiles and /var/lib). /run/dbus is masked
# as a directory so the mask survives a D-Bus restart that recreates the
# socket. See systemd.exec(5), "Sandboxing":
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#ReadWritePaths=
InaccessiblePaths=/run/dbus /run/mhvtl-control-apply /var/lib/mhvtl-control-apply
# An empty read-only /run/systemd hides the private manager socket and the
# system/ and transient/ unit dirs; the journal sockets are bound back so
# syslog and journald logging keep working. The daemon does not use sd_notify:
# if it ever moves to Type=notify or WatchdogSec=, bind /run/systemd/notify
# back too, or every start times out waiting for READY=1. With no D-Bus and
# no private socket, the daemon cannot restart units itself; that is the
# mhvtl-control-apply helper's job.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#TemporaryFileSystem=
TemporaryFileSystem=/run/systemd:ro
BindReadOnlyPaths=/run/systemd/journal
# Where /etc/resolv.conf links into /run/systemd/resolve, the link would dangle
# without this; '-' because hosts without systemd-resolved lack the dir.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#BindPaths=
BindReadOnlyPaths=-/run/systemd/resolve
PrivateTmp=yes
# PrivateDevices must stay off: it would hide /dev/sg* and the disks to format.
PrivateDevices=no
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
# RestrictSUIDSGID must stay off: mktape creates each cartridge directory
# with S_ISGID (mhvtl usr/vtlcart.c, file_be_open_cartridge()), which it
# refuses.
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
