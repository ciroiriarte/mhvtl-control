# Options for mhvtld.service. See `mhvtld -h` for the full list.
#
# mhvtld binds the loopback interface by default. To reach it from another
# host, set --listen to a routable address and set a token: mhvtld refuses a
# non-loopback bind without one (unless given --insecure).
MHVTLD_OPTS="--listen 127.0.0.1:8080"

# Bearer token required on /api/v1/*. Keep this file mode 0600.
#MHVTLD_API_TOKEN=

# HTTPS: add to MHVTLD_OPTS
#   --tls-cert /etc/mhvtl/mhvtld.crt --tls-key /etc/mhvtl/mhvtld.key
