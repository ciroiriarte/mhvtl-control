# Options for mhvtl-control.service. See `mhvtl-control -h` for the full list.
#
# mhvtl-control binds the loopback interface by default. To reach it from another
# host, set --listen to a routable address and set a token: mhvtl-control refuses a
# non-loopback bind without one (unless given --insecure).
MHVTL_CONTROL_OPTS="--listen 127.0.0.1:8080"

# Bearer token required on /api/v1/*. Keep this file mode 0600.
#MHVTL_CONTROL_API_TOKEN=

# HTTPS: add to MHVTL_CONTROL_OPTS
#   --tls-cert /etc/mhvtl/mhvtl-control.crt --tls-key /etc/mhvtl/mhvtl-control.key
